# AegisFlow defaults to safe mock mode. No key is required.
AEGISFLOW_MODE=mock

# Real mode (optional). Requires all four:
#   1. AEGISFLOW_MODE=real
#   2. AEGISFLOW_ALLOW_EXTERNAL_LLM=true
#   3. the matching provider key (GOOGLE_API_KEY, OPENROUTER_API_KEY or OPENAI_API_KEY)
#   4. at least one AEGISFLOW_MODEL id below
#
# Gemini is the default provider, so a bare model id goes to it. AEGISFLOW_MODEL
# is a comma separated list in failover order: the first entry is the primary.
# Use provider:model to name a provider per entry:
#   AEGISFLOW_MODEL=gemini:gemini-3.5-flash,openrouter:openai/gpt-4o
# A slash only counts as a provider prefix when it names the configured
# provider. A cross-provider slash such as openai/gpt-4o is rejected instead of
# being guessed at, so a request cannot silently reach the wrong vendor.
AEGISFLOW_PROVIDER=gemini
AEGISFLOW_MODEL=your-model-id
AEGISFLOW_ALLOW_EXTERNAL_LLM=false

# Google Gemini (default provider)
GOOGLE_API_KEY=

# OpenRouter (OpenAI-compatible). Also selectable as openrouter:model.
OPENROUTER_API_KEY=

# Direct OpenAI. Also selectable as openai:model.
OPENAI_API_KEY=

# Limits
AEGISFLOW_MAX_FILE_MB=10
AEGISFLOW_MAX_RETRIES=2
AEGISFLOW_MAX_REVISIONS=2
AEGISFLOW_MAX_DELEGATION_DEPTH=3
AEGISFLOW_RECURSION_LIMIT=80

# Storage
AEGISFLOW_DATA_DIR=data
