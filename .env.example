# AegisFlow defaults to safe mock mode. No key is required.
AEGISFLOW_MODE=mock

# Real mode (optional). Requires all four:
#   1. AEGISFLOW_MODE=real
#   2. AEGISFLOW_ALLOW_EXTERNAL_LLM=true
#   3. the matching provider key (e.g. OPENROUTER_API_KEY)
#   4. exactly one AEGISFLOW_MODEL id below
AEGISFLOW_PROVIDER=openrouter
AEGISFLOW_MODEL=your-model-id
AEGISFLOW_ALLOW_EXTERNAL_LLM=false

# OpenRouter (OpenAI-compatible). Put the key in a local .env file, never in git.
OPENROUTER_API_KEY=

# Google Gemini
GOOGLE_API_KEY=

# Direct OpenAI (optional)
OPENAI_API_KEY=

# Limits
AEGISFLOW_MAX_FILE_MB=10
AEGISFLOW_MAX_RETRIES=2
AEGISFLOW_MAX_REVISIONS=2
AEGISFLOW_MAX_DELEGATION_DEPTH=3
AEGISFLOW_RECURSION_LIMIT=80

# Storage
AEGISFLOW_DATA_DIR=data
